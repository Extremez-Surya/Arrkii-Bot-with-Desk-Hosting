# ====================================
# DISCORD BOT CONFIGURATION
# ====================================
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
PREFIX=>
OWNER_IDS=your_discord_user_id

# ====================================
# DATABASE CONFIGURATION (MongoDB)
# ====================================
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/astrix?retryWrites=true&w=majority

# ====================================
# LAVALINK V4 AUDIO NODE CONFIGURATION
# ====================================
# You can provide either LAVALINK_URL or separate HOST/PORT
LAVALINK_URL=lavalinkv4.serenetia.com:443
# LAVALINK_HOST=localhost
# LAVALINK_PORT=2333
LAVALINK_PASSWORD=https://seretia.link/discord
LAVALINK_SECURE=true
NODE_NAME=Astrix-Lavalink
NODE_SOURCE=ytsearch

# ====================================
# SPOTIFY API (For Spotify Links & Tracks)
# ====================================
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ====================================
# EMBED & BRANDING
# ====================================
EMBED_COLOR=#2f3136
SUPPORT_SERVER_URL=https://discord.gg/yVxV7AxDBB
INVITE_URL=https://discord.com/api/oauth2/authorize?client_id=your_client_id&permissions=824671333721&scope=bot

# ====================================
# WEBHOOK LOGGING (Optional)
# ====================================
WEBHOOK_LOGS=
WEBHOOK_PLAYER_CREATE=
WEBHOOK_PLAYER_DELETE=
WEBHOOK_GUILD_JOIN=
WEBHOOK_GUILD_LEAVE=
WEBHOOK_CMDRUN=

# ====================================
# TOP.GG VOTING (Optional)
# ====================================
TOPGG_TOKEN=here
